meters:
  guest_limit:
    meter_id: 1
    entry:
      flags: "KBPS"
      bands:
        - type: "DROP"
          rate: 10000

acls:
  guest_ratelimit:
    - rule:
        actions:
          meter: guest_limit
          allow: 1

  mgmt_portsec:
    - rule:
        dl_src: "00:00:00:00:00:05"
        actions:
          allow: 1
    - rule:
        actions:
          allow: 0

vlans:
  employee:
    vid: 10
    description: "Employee"
  guest:
    vid: 20
    description: "Gast"
  mgmt:
    vid: 30
    description: "Management"

dps:
  sA0:
    dp_id: 0x1
    hardware: "Open vSwitch"
    interfaces:
      1: {description: "naar sA1", tagged_vlans: [employee, guest, mgmt]}
      2: {description: "naar sA2", tagged_vlans: [employee, guest, mgmt]}
      3: {description: "darkfiber naar sB0", tagged_vlans: [employee, guest, mgmt]}
      4: {description: "NAT intern employee", native_vlan: employee}
      5: {description: "NAT intern gast", native_vlan: guest}
  sA1:
    dp_id: 0x2
    hardware: "Open vSwitch"
    interfaces:
      1: {description: "uplink sA0", tagged_vlans: [employee, guest, mgmt]}
      2: {description: "hA1", native_vlan: employee}
  sA2:
    dp_id: 0x3
    hardware: "Open vSwitch"
    interfaces:
      1: {description: "uplink sA0", tagged_vlans: [employee, guest, mgmt]}
      2: {description: "hA2", native_vlan: guest, acls_in: [guest_ratelimit]}
  sB0:
    dp_id: 0x4
    hardware: "Open vSwitch"
    interfaces:
      1: {description: "naar sB1", tagged_vlans: [employee, guest, mgmt]}
      2: {description: "naar sB2", tagged_vlans: [employee, guest, mgmt]}
      3: {description: "naar sB3", tagged_vlans: [employee, guest, mgmt]}
      4: {description: "darkfiber naar sA0", tagged_vlans: [employee, guest, mgmt]}
  sB1:
    dp_id: 0x5
    hardware: "Open vSwitch"
    interfaces:
      1: {description: "uplink sB0", tagged_vlans: [employee, guest, mgmt]}
      2: {description: "hB1", native_vlan: employee}
  sB2:
    dp_id: 0x6
    hardware: "Open vSwitch"
    interfaces:
      1: {description: "uplink sB0", tagged_vlans: [employee, guest, mgmt]}
      2: {description: "hB2", native_vlan: mgmt, max_hosts: 1, acls_in: [mgmt_portsec]}
  sB3:
    dp_id: 0x7
    hardware: "Open vSwitch"
    interfaces:
      1: {description: "uplink sB0", tagged_vlans: [employee, guest, mgmt]}
      2: {description: "hB3", native_vlan: guest, acls_in: [guest_ratelimit]}
